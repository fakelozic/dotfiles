" Minimal Vim: Gruvbox-style colors using Vim's built-in Retrobox theme.
set nocompatible
filetype plugin indent on
syntax enable

set background=dark
if has('termguicolors')
  set termguicolors
endif

" Familiar layout, with a quiet gutter and no extra UI rows.
set number relativenumber
set cursorline
set signcolumn=yes
set scrolloff=5
set showtabline=1
set laststatus=2
set noshowcmd noruler
set showmode
set fillchars=vert:│
let &statusline = ' %f %m%r%h%w%=%y  %l:%c  %p%% '

" Small conveniences; language indentation comes from Vim's filetype plugins.
set mouse=a
set splitright splitbelow
set hidden
set incsearch ignorecase smartcase
set wildmenu

" Fedora's Vim is built without clipboard support, so the + and * registers
" go through wl-clipboard. Outside Wayland the provider reports unavailable.
if has('clipboard_provider') && executable('wl-copy') && executable('wl-paste')
  function! s:WlAvailable() abort
    return !empty($WAYLAND_DISPLAY)
  endfunction

  function! s:WlCopy(reg, type, lines) abort
    let l:text = join(a:lines, "\n") .. (a:type ==# 'V' ? "\n" : '')
    silent call system('wl-copy' .. (a:reg ==# '*' ? ' --primary' : ''), l:text)
  endfunction

  " A trailing newline marks a linewise paste, as it does in Neovim.
  function! s:WlPaste(reg) abort
    let l:cmd = 'wl-paste --no-newline --type text' .. (a:reg ==# '*' ? ' --primary' : '')
    silent let l:text = system(l:cmd .. ' 2>/dev/null')
    if v:shell_error
      return []
    endif
    if l:text =~# "\n$"
      return ['V', split(l:text[:-2], "\n", 1)]
    endif
    return ['v', split(l:text, "\n", 1)]
  endfunction

  let v:clipproviders['wl'] = {
        \ 'available': function('s:WlAvailable'),
        \ 'copy': {'+': function('s:WlCopy'), '*': function('s:WlCopy')},
        \ 'paste': {'+': function('s:WlPaste'), '*': function('s:WlPaste')},
        \ }
  set clipmethod^=wl
  set clipboard=unnamedplus
endif

function! s:MinimalColors() abort
  highlight Normal       guifg=#ebdbb2 guibg=NONE    gui=NONE ctermfg=223 ctermbg=NONE cterm=NONE
  highlight LineNr       guifg=#928374 guibg=NONE    gui=NONE ctermfg=243 ctermbg=NONE cterm=NONE
  highlight SignColumn   guifg=#928374 guibg=NONE    gui=NONE ctermfg=243 ctermbg=NONE cterm=NONE
  highlight FoldColumn   guifg=#928374 guibg=NONE    gui=NONE ctermfg=243 ctermbg=NONE cterm=NONE
  highlight CursorLine   guifg=NONE    guibg=#3c3836 gui=NONE ctermfg=NONE ctermbg=237 cterm=NONE
  highlight CursorLineNr guifg=#ebdbb2 guibg=NONE    gui=NONE ctermfg=223 ctermbg=NONE cterm=NONE
  highlight Comment      guifg=#928374 guibg=NONE    gui=NONE ctermfg=243 ctermbg=NONE cterm=NONE
  highlight VertSplit    guifg=#665c54 guibg=NONE    gui=NONE ctermfg=241 ctermbg=NONE cterm=NONE
  highlight VertSplitNC  guifg=#504945 guibg=NONE    gui=NONE ctermfg=239 ctermbg=NONE cterm=NONE
  highlight StatusLine   guifg=#ebdbb2 guibg=#3c3836 gui=NONE ctermfg=223 ctermbg=237 cterm=NONE
  highlight StatusLineNC guifg=#a89984 guibg=#282828 gui=NONE ctermfg=246 ctermbg=235 cterm=NONE
endfunction

augroup minimal_vim_colors
  autocmd!
  autocmd ColorScheme retrobox call s:MinimalColors()
augroup END
colorscheme retrobox
