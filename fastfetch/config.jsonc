{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/fedora.txt",
    "padding": {
      "top": 5,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "38;2;131;165;152"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 17
    },
    "color": {
      "keys": "38;2;131;165;152",
      "title": "38;2;251;133;0",
      "output": "38;2;242;232;207",
      "separator": "38;2;146;131;116"
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "color": {
        "green": "38;2;142;192;124",
        "yellow": "38;2;250;189;47",
        "red": "38;2;251;73;52"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;251;133;0",
        "at": "38;2;146;131;116",
        "host": "38;2;251;133;0"
      }
    },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}── system ────────────────────"
    },
    {
      "type": "os",
      "key": "  os",
      "keyColor": "38;2;131;165;152",
      "format": "{name} {version-id} · {variant}"
    },
    {
      "type": "kernel",
      "key": "  kernel",
      "keyColor": "38;2;131;165;152"
    },
    {
      "type": "uptime",
      "key": "󰅐  uptime",
      "keyColor": "38;2;131;165;152"
    },
    {
      "type": "packages",
      "key": "󰏖  packages",
      "keyColor": "38;2;131;165;152",
      "format": "{rpm} rpm · {flatpak-system} flatpak · {flatpak-user} flatpak-user · {appimage} appimage"
    },
    {
      "type": "shell",
      "key": "  shell",
      "keyColor": "38;2;131;165;152"
    },
    {
      "type": "locale",
      "key": "  locale",
      "keyColor": "38;2;131;165;152"
    },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}── desktop ───────────────────"
    },
    {
      "type": "de",
      "key": "  desktop",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "wm",
      "key": "  wm",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "wmtheme",
      "key": "󰏘  wm theme",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "theme",
      "key": "  theme",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "icons",
      "key": "  icons",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "font",
      "key": "  font",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "cursor",
      "key": "  cursor",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "terminal",
      "key": "  terminal",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "terminalfont",
      "key": "  term font",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "display",
      "key": "󰍹  display",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}── hardware ──────────────────"
    },
    {
      "type": "host",
      "key": "󰚗  board",
      "keyColor": "38;2;250;189;47"
    },
    {
      "type": "cpu",
      "key": "  cpu",
      "keyColor": "38;2;250;189;47"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu",
      "keyColor": "38;2;250;189;47"
    },
    {
      "type": "memory",
      "key": "󰍛  memory",
      "keyColor": "38;2;250;189;47"
    },
    {
      "type": "swap",
      "key": "  swap",
      "keyColor": "38;2;250;189;47"
    },
    {
      "type": "disk",
      "key": "󰋊  disk",
      "keyColor": "38;2;250;189;47"
    },
    {
      "type": "localip",
      "key": "  local ip",
      "keyColor": "38;2;250;189;47"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
