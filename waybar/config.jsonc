{
  "output": "HDMI-A-1",
  "layer": "top",
  "position": "bottom",
  "height": 30,
  "spacing": 2,

  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "idle_inhibitor", "pulseaudio", "network", "cpu", "memory", "custom/power"],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },
  "sway/mode": {"format": "󰌌  {}"},
  "sway/window": {"format": "{title}", "max-length": 48, "rewrite": {"(.*) — Mozilla Firefox": "  $1"}},
  "clock": {
    "interval": 1,
    "format": "󰥔  {:%a %d %b  %H:%M:%S}",
    "format-alt": "󰃭  {:%Y-%m-%d  %H:%M:%S}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
  },
  "tray": {"icon-size": 16, "spacing": 8},
  "idle_inhibitor": {"format": "{icon}", "format-icons": {"activated": "", "deactivated": ""}},
  "cpu": {"interval": 3, "format": "  {usage}%", "tooltip": true},
  "memory": {"interval": 3, "format": "  {percentage}%", "tooltip-format": "{used:0.1f} GiB used"},
  "network": {
    "interval": 5,
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰖪  offline",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },
  "pulseaudio": {
    "scroll-step": 2,
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-bluetooth": "󰂰  {volume}%",
    "format-icons": {"headphone": "", "default": ["", "", ""]},
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "custom/power": {"format": "󰐥", "tooltip": false, "on-click": "swaynag -t warning -m 'Power menu' -b 'Lock' 'swaylock -f -c 282828' -b 'Suspend' 'systemctl suspend' -b 'Reboot' 'systemctl reboot' -b 'Shutdown' 'systemctl poweroff'"}
}
