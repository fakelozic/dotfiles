* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: #ebdbb2;
    border-color: #504945;
}

window {
    width: 360px;
    height: 362px;
    location: center;
    anchor: center;
    background-color: #1d2021;
    border: 1px;
    border-color: #8ec07c;
    border-radius: 0px;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview, textbox-hint ];
    spacing: 12px;
}

inputbar {
    expand: false;
    children: [ prompt ];
    padding: 0px 2px 10px;
    border: 0px 0px 1px;
    border-color: #504945;
}

prompt {
    font: "JetBrainsMono Nerd Font Bold 13";
    text-color: #fabd2f;
}

listview {
    expand: true;
    lines: 5;
    columns: 1;
    fixed-height: true;
    dynamic: false;
    cycle: true;
    scrollbar: false;
    spacing: 4px;
    padding: 0px;
    border: 0px;
}

element {
    padding: 10px 12px;
    border: 0px;
    border-radius: 0px;
    children: [ element-text ];
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: #ebdbb2;
}

element selected.normal {
    background-color: #8ec07c;
    text-color: #1d2021;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

textbox-hint {
    expand: false;
    str: "↑ ↓ move   ↵ select   Esc close";
    font: "JetBrainsMono Nerd Font 9";
    text-color: #a89984;
    padding: 10px 2px 0px;
    border: 1px 0px 0px;
    border-color: #504945;
}
